# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (choose ONE option)

# Option 1: Neon/Cloud PostgreSQL (recommended for persistence)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Option 2: Local Docker PostgreSQL (uncomment if using docker-compose)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_DB=kdsh
# POSTGRES_USER=kdsh
# POSTGRES_PASSWORD=kdsh_password
